# =============================================================================
# HumanLink — Variables de entorno (copiar a .env)
# =============================================================================
# Windows (CMD):     copy .env.example .env
# Windows (PowerShell): Copy-Item .env.example .env
# Linux / macOS:     cp .env.example .env
# =============================================================================

# --- Base de datos (obligatorio) ---
# MySQL 8+ o MariaDB 10.6+. Formato Prisma:
# mysql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
# Crear BD/usuario: database/setup_mysql.sql (ver README.md)
DATABASE_URL="mysql://humanlink:humanlink2026@localhost:3306/humanlink"

# --- Autenticación (obligatorio) ---
# Secreto para firmar JWT. Use una cadena larga y aleatoria en producción.
JWT_SECRET="humanlink-secret-cambiar-en-produccion-2026"

# --- URL pública de la aplicación (recomendado) ---
# Enlaces en correos (recuperación de contraseña, etc.)
APP_URL="http://localhost:3000"

# --- Django (backend HumanLink) ---
DJANGO_SECRET_KEY="humanlink-django-secret-cambiar-en-produccion"
DJANGO_DEBUG="true"
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1,0.0.0.0"
# Alternativa explícita MySQL (si no usa DATABASE_URL):
# MYSQL_HOST="localhost"
# MYSQL_PORT="3306"
# MYSQL_DATABASE="humanlink"
# MYSQL_USER="humanlink"
# MYSQL_PASSWORD="humanlink2026"

# --- Correo SMTP (opcional) ---
# Con SMTP_ENABLED=false los correos se registran en EmailLog (modo demo).
SMTP_ENABLED="false"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="HumanLink <no-reply@humanlink.mx>"

# --- Producción (opcional) ---
# En local dejar comentado o "false". En producción con HTTPS: "true" (default).
# FORCE_HTTPS="false"

# --- Node (opcional, Next.js lo define automáticamente) ---
# NODE_ENV="development"
