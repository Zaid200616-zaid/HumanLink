# Base de datos MySQL (Bases de Datos Avanzadas)
# Formato: mysql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
DATABASE_URL="mysql://humanlink:humanlink2026@localhost:3306/humanlink"

# Secreto para JWT (cambiar en producción)
JWT_SECRET="humanlink-secret-cambiar-en-produccion-2026"

# Envío de correos (opcional). Con SMTP_ENABLED=false solo se registra en EmailLog.
SMTP_ENABLED="false"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="HumanLink <no-reply@humanlink.mx>"

# URL base para enlaces en correos (recuperación de contraseña, etc.)
# Desarrollo: usar HTTP (no https). Ej.: http://localhost:3000 o http://192.168.x.x:3000
APP_URL="http://localhost:3000"

# En producción detrás de nginx/Apache con TLS, dejar FORCE_HTTPS activo (default).
# Solo en local con "npm start": no aplica redirect a https en localhost/LAN.
# FORCE_HTTPS="false"
